local function getAvatarHeadshot(userId)
    local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. userId .. "&size=420x420&format=Png&isCircular=false&includeBackground=false"
    local response = request({
        Url = url,
        Method = "GET"
    })
    
    if response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data.data and data.data[1] and data.data[1].imageUrl then
            return data.data[1].imageUrl
        end
    end
    return nil
end

