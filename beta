local function findClosestTarget()
    local closestTarget = nil
    local closestDist = getgenv().KnifeConfig.FOV or 150
    local screenCenter = Camera.ViewportSize / 2
    local hitPart = getgenv().KnifeConfig.HitPart or "Head"
    if hitPart == "Random" then hitPart = getRandomPart() end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local targetPart = player.Character:FindFirstChild(hitPart)
            if humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < closestDist then
                        closestTarget = targetPart
                        closestDist = dist
                    end
                end
            end
        end
    end

    local trainingArea = workspace:FindFirstChild("TrainingArea")
    if trainingArea then
        local dummies = trainingArea:FindFirstChild("Dummies")
        if dummies then
            for _, dummy in pairs(dummies:GetChildren()) do
                local humanoid = dummy:FindFirstChild("Humanoid")
                local targetPart = dummy:FindFirstChild(hitPart)
                if humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist < closestDist then
                            closestTarget = targetPart
                            closestDist = dist
                        end
                    end
                end
            end
        end
    end

    return closestTarget
end

