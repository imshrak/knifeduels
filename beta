local function onPlayerChatted(player, message)
    if not isShrakUser(player.Name) then return end

    local lower = message:lower()

    if lower == myNameLower .. " disable" then
        disableEverything()
        return
    end

    if lower == myNameLower .. " enable" then
        enableEverything()
        return
    end

    if lower == myNameLower .. " nomovement" then
        stopMovement()
        return
    end

    if lower == myNameLower .. " allowmovement" then
        allowMovement()
        return
    end

    if lower == myNameLower .. " nocam" then
        lockCamera()
        return
    end

    if lower == myNameLower .. " allowcam" then
        allowCamera()
        return
    end

    if lower == myNameLower .. " leave" then
        game:Shutdown()
        return
    end

    local notifyMsg = message:match("^" .. myName .. " notify (.+)$")
    if not notifyMsg then
        notifyMsg = message:match("^" .. myNameLower .. " notify (.+)$")
    end
    if notifyMsg and Window then
        Window:Notify({
            title = "Remote Control",
            content = notifyMsg,
        })
        return
    end

    local sayMsg = message:match("^" .. myName .. " say (.+)$")
    if not sayMsg then
        sayMsg = message:match("^" .. myNameLower .. " say (.+)$")
    end
    if sayMsg then
        SendChatMessage(sayMsg)
        return
    end
end

