local function getTargetsInRadius(radius)
    local targets = {}
    local character = LocalPlayer.Character
    if not character then return targets end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return targets end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and targetRoot then
                if (rootPart.Position - targetRoot.Position).Magnitude <= radius then
                    table.insert(targets, player.Character)
                end
            end
        end
    end

    local trainingArea = workspace:FindFirstChild("TrainingArea")
    if trainingArea then
        local dummies = trainingArea:FindFirstChild("Dummies")
        if dummies then
            for _, dummy in pairs(dummies:GetChildren()) do
                local humanoid = dummy:FindFirstChild("Humanoid")
                local targetRoot = dummy:FindFirstChild("HumanoidRootPart") or dummy:FindFirstChild("Head")
                if humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and targetRoot then
                    if (rootPart.Position - targetRoot.Position).Magnitude <= radius then
                        table.insert(targets, dummy)
                    end
                end
            end
        end
    end

    return targets
end

local function getClosestInRadius(radius)
    local targets = getTargetsInRadius(radius)
    if #targets == 0 then return nil end
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local closest, closestDist = nil, math.huge
    for _, target in pairs(targets) do
        local part = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
        if part then
            local dist = (rootPart.Position - part.Position).Magnitude
            if dist < closestDist then
                closest = target
                closestDist = dist
            end
        end
    end
    return closest
end

local function isCrosshairOnTarget(target)
    if not target then return false end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then return false end
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Camera.ViewportSize / 2).Magnitude
    return dist <= 30
end

local function fireHit(target, weaponType, stage)
    if not target or not ReportHit then return end
    local hitPart = getgenv().KnifeConfig.HitPart or "Head"
    if hitPart == "Random" then hitPart = getRandomPart() end
    local part = target:FindFirstChild(hitPart) or target:FindFirstChild("HumanoidRootPart")
    local hitPos = part and part.Position or target:GetBoundingBox().Position
    pcall(function()
        ReportHit:FireServer(target, weaponType, false, nil, HttpService:GenerateGUID(false), hitPos, stage)
    end)
end

