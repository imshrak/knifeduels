        if h then h:Destroy() end
    end
end)

local auraCooldown = 0
local knifeTriggerCooldown = 0

RunService.Heartbeat:Connect(function()
    local now = tick()

    if getgenv().MovementLocked and getgenv().LockedPosition then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(getgenv().LockedPosition)
        end
    end

    if getgenv().CameraLocked and getgenv().LockedCameraCFrame then
        Camera.CFrame = getgenv().LockedCameraCFrame
    end

    if not getgenv().ScriptLocked then
        if getgenv().KnifeAuraEnabled and now - auraCooldown >= 0.2 then
            local target = getClosestInRadius(getgenv().AuraRadius)
            if target then
                fireHit(target, "Knife", 3)
                auraCooldown = now
            end
        end

        if getgenv().KnifeTriggerbotEnabled and now - knifeTriggerCooldown >= 0.2 then
            local target = getClosestInRadius(getgenv().AuraRadius)
            if target and isCrosshairOnTarget(target) then
                fireHit(target, "Knife", 3)
                knifeTriggerCooldown = now
            end
        end

        if getgenv().AutoFireEnabled and KnifeController and now - autoFireCooldown >= 0.1 then
            local screenCenter = Camera.ViewportSize / 2
            local bestTarget = nil
            local bestDist = math.huge

            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local humanoid = player.Character:FindFirstChild("Humanoid")
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and hrp then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = hrp
                            end
                        end
                    end
                end
            end

            if bestTarget and bestDist <= (getgenv().KnifeConfig.FOV or 150) then
                pcall(function()
                    KnifeController:AttemptThrow(os.clock())
                end)
                autoFireCooldown = now
            end
        end
    end

    if getgenv().ChamsEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not player.Character:FindFirstChild("ChamsHighlight") then
                    manageChams(player)
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local config = getgenv().KnifeConfig
    local silentAimEnabled = config.Enabled and not getgenv().ScriptLocked

    if config.ShowFOV and silentAimEnabled then
        FOVCircle.Visible = true
        FOVCircle.Position = Camera.ViewportSize / 2
        FOVCircle.Radius = config.FOV
    else
        FOVCircle.Visible = false
    end

    if getgenv().LineToTargetEnabled and silentAimEnabled then
        local target = findClosestTarget()
        if target then
            local screenPos, onScreen = Camera:WorldToViewportPoint(target.Position)
            if onScreen then
                TargetLine.Visible = true
                TargetLine.From = Camera.ViewportSize / 2
                TargetLine.To = Vector2.new(screenPos.X, screenPos.Y)
            else
                TargetLine.Visible = false
            end
        else
            TargetLine.Visible = false
        end
    else
        TargetLine.Visible = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        MenuOpen = not MenuOpen
        Window:ToggleHide()
    end
end)
