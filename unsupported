local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()

local HttpService = game:GetService("HttpService")

repeat task.wait() until game:GetService("Players").LocalPlayer ~= nil

local Window = Library:CreateWindow({
    Title = "UNSUPPORTED",
    Footer = "discord.gg/N7Fa87GtKe",
    ShowCustomCursor = true,
})

local MainTab = Window:AddTab("", "")

local Group = MainTab:AddLeftGroupbox("")

Group:AddLabel({
    Text = "Your executor is unsupported by this script.",
    DoesWrap = true,
})

Group:AddLabel({
    Text = "For help finding a supported executor, join our Discord.",
    DoesWrap = true,
})

Group:AddDivider()

Group:AddButton({
    Text = "Copy Discord Invite",
    Func = function()
        local inviteLink = "https://discord.gg/N7Fa87GtKe"
        setclipboard(inviteLink)
        Library:Notify({
            Title = "Copied!",
            Description = "Discord invite copied to clipboard!",
            Time = 3,
        })
    end,
})

request({
    Url = "http://127.0.0.1:6463/rpc?v=1",
    Method = "POST",
    Headers = {
        ["Content-Type"] = "application/json",
        Origin = "https://discord.com"
    },
    Body = HttpService:JSONEncode({
        cmd = "INVITE_BROWSER",
        nonce = HttpService:GenerateGUID(false),
        args = {
            code = "N7Fa87GtKe"
        }
    })
})
